# ---------------------------------------------------------------------------
# Young & Elevated Sports Performance — environment template
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Resend (Class A public inquiry email delivery)
#
# RESEND_API_KEY      Server-only. Never exposed to the browser. Set in Vercel
#                     project settings (Production + Preview), not in git.
# INQUIRY_FROM_EMAIL  Must be an address on a domain verified in Resend.
#                     Approved production sender: info@youngelevatedsports.com
#                     This is a *sending* identity only; it is not assumed to
#                     have a receiving mailbox.
# INQUIRY_TO_EMAIL    Destination inbox that receives inquiry notifications.
#                     Must be a monitored business mailbox. When unset, all
#                     inquiry routes return 503 rather than silently dropping
#                     submissions.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=info@youngelevatedsports.com
INQUIRY_TO_EMAIL=

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://youngelevatedsports.com

# ---------------------------------------------------------------------------
# Reserved for later batches — do not populate yet.
# OPERON CRM adapter (integration spec only in Batch 001)
# OPERON_API_BASE_URL=
# OPERON_API_KEY=
#
# TAYA content adapter (content is typed locally in Batch 001)
# TAYA_API_BASE_URL=
# TAYA_API_KEY=
#
# Secure registration storage (Class B — not implemented)
# REGISTRATION_STORAGE_URL=
# REGISTRATION_STORAGE_KEY=
# ---------------------------------------------------------------------------
